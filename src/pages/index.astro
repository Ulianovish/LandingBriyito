---
import About from '~/components/about.astro';
import Classes from '~/components/classes.astro';
import Faq from '~/components/faq.astro';
import Modal from '~/components/modal.astro';
import Splash from '~/components/splash.astro';
import TargetAudience from '~/components/target-audience.astro';
import Testimonials from '~/components/testimonials.astro';
import { siteConfig } from '~/config/site.config';
import BaseLayout from '~/layouts/base.astro';

const description = 'Aprende El Increíble Método Mamá Que Factura';
---

<BaseLayout title="Mamá Que Factura" description={description} ogTitle="Mama Que Factura">
  <!-- <Starfield /> -->
  <Splash />
  <!-- <Intro /> -->
  <Classes />
  <TargetAudience />
  <Testimonials />
  <Faq />
  <About />

  <p class="relative z-10 pb-12 text-center">
    <a
      href="/circulo-de-crecimiento"
      class="font-semibold text-pink-600 underline underline-offset-4 transition text-sm hover:text-pink-700"
    >
      {siteConfig.circle.ui.landingLink}
    </a>
  </p>

  <Modal />
</BaseLayout>
