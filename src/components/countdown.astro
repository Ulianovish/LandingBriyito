---
import { siteConfig } from '~/config/site.config';
---

<div class="middle" data-aos="fade-up">
  <h1 class="gradient-text font-extrabold tracking-tighter text-3xl">{siteConfig.dates.title}</h1>
  <div class="time font-semibold uppercase">
    <span class="gradient-text">
      <div id="d">00</div>
      Días
    </span>
    <span class="gradient-text">
      <div id="h">00</div>
      Horas
    </span>
    <span class="gradient-text">
      <div id="m">00</div>
      Minutos
    </span>
    <span class="gradient-text">
      <div id="s">00</div>
      Segundos
    </span>
  </div>
</div>
<script>
  import AOS from 'aos';
  import 'aos/dist/aos.css';
  import { siteConfig } from '~/config/site.config';
  import { getCountdown } from '~/utils/countdown';
  AOS.init({
    duration: 750
  });
  const d = document.getElementById('d');
  const h = document.getElementById('h');
  const m = document.getElementById('m');
  const s = document.getElementById('s');
  const masterclassDate = new Date(siteConfig.dates.masterclass);

  function renderCountdown() {
    const countdown = getCountdown(masterclassDate, new Date());

    if (d) {
      d.innerHTML = countdown.days;
    }
    if (h) {
      h.innerHTML = countdown.hours;
    }
    if (m) {
      m.innerHTML = countdown.minutes;
    }
    if (s) {
      s.innerHTML = countdown.seconds;
    }

    return countdown.remainingMs;
  }

  function initCountdown() {
    if (renderCountdown() === 0) {
      return;
    }

    const interval = setInterval(() => {
      if (renderCountdown() === 0) {
        clearInterval(interval);
      }
    }, 1000);
  }

  initCountdown();
</script>
<style>
  .middle {
    text-align: center;
    user-select: none;
  }

  .time {
    color: #d99c3b;
    text-transform: uppercase;
    display: flex;
    justify-content: center;
  }

  .time span {
    padding: 0 14px;
    font-size: 0.8rem;
  }

  .time span div {
    font-size: 1.8rem;
  }

  @media (max-width: 740px) {
    .label {
      font-size: 1.7rem;
    }
    .time span {
      padding: 0 16px;
      font-size: 0.6rem;
    }
    .time span div {
      font-size: 2rem;
    }
  }
</style>
